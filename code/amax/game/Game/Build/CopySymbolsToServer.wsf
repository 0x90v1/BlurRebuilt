<job>
  <script language="JScript" src="..\..\..\..\..\bin\scripts\compilation\core.js"/>
  <script language="JScript" src="..\..\..\..\..\bin\scripts\common\exec.js"/>
  <script language="JScript" src="..\..\..\..\..\bin\scripts\compilation\filesystem.js"/>
  <script language="JScript" src="..\..\..\..\..\bin\scripts\compilation\misc.js"/>
  <script language="JScript" src="..\..\..\..\..\bin\scripts\compilation\symbol_server2.js"/>
  <script language="JScript">

	var copyList = new Array();         // Array of folders and types to copy to symbol server
	var registerList = new Array();     // Array of folders and types to register to symbol server

// Not sure if this next line is still needed
 	SetupSymbolServer(Env("project_name"), "\\code\\amax\\game\\");
	
// Source code folder list we want to copy
    copyList.push([ [ "code\\mercury", "code\\amax", "code\\vendor" ], "*.cpp *.c *.h *.hpp *.inl" ]);

// Specify path to bin folder for all game exe's
	var gameBinFolder = "code\\amax\\game\\bin";

// Shouldn't need to modify below this line
    {
        var platformList = new Array();
        
        var platformParam = WScript.Arguments.Item(0);
        
        if (platformParam == "ALL_PLATFORMS")
        {
            platformList.push("XBOX_360");
            platformList.push("WIN32");
        }
        else
        {
            platformList.push(platformParam);
        }

        // Add to copy list per platform
        for (var iPlatform = 0; iPlatform < platformList.length; iPlatform++)
        {
            var platform = platformList[iPlatform];
            
            var binFolders = new Array();
            
            for (var i = 1; i < WScript.Arguments.length; i++)
            {
                var buildType = WScript.Arguments.Item(i);
                var exeFolder = gameBinFolder + "\\" + platform + "\\" + buildType;
                
                binFolders.push(exeFolder);
                registerList.push([ exeFolder + "\\*.*\"", platform ]);
            }
            
            var exeFilter = undefined;
            if (platform == "XBOX_360")
                exeFilter = "*.exe *.xex *.pdb";
            else if (platform == "WIN32")
                exeFilter = "*.exe *.pdb";
            
            if (exeFilter != undefined)
            {
                copyList.push([ binFolders, "*.exe *.xex *.pdb" ]);
            }
        }
    }

	var t1 = TimeStamp();
	
	CopyAndRegisterWithSymbolServer(copyList, registerList);
	
	WScript.Echo("BUILD SUCCESSFUL\n");
	
	TimeStampDiff(t1);

  </script>
</job>
