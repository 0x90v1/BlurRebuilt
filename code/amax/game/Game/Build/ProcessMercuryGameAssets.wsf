<job>
  <script language="JScript" src="..\..\..\..\..\bin\scripts\common\copy.js"/>
  <script language="JScript" src="..\..\..\..\..\bin\scripts\common\exec.js"/>
  <script language="JScript" src="..\..\..\..\..\bin\scripts\luntbuild\PublishUtils.js"/>
  <script language="JScript">
  	
  	var g_iErrors = 0;
  	if (WScript.Arguments.length < 3)
	{
		WScript.Echo("Incorrect number of arguments. Usage: ProcessMercuryGameLevels.wsf PROJECT ASSET_TYPE LOCATION\n");
		WScript.Echo("PUBLISH FAILED\n");
		WScript.Quit();
	}
	
	var project = WScript.Arguments.Item(0);
	var assetType = WScript.Arguments.Item(1);
	var location = WScript.Arguments.Item(2);

	//Update tools
	var command = "\\\\Biztools01\\shared\\dev_setup_stub\\setup.bat";
	WScript.Echo("Execute command: " + command );
	ExecAndCapture(command);
	
	//command = "%BIZARRE_ROOT%\\tools\\common_tools\\scripts\\installers\\game\\lib\\install_game_tool_chain_impl.bat \\biztools01 MercuryGame Retail Live";
	command = "%BIZARRE_ROOT%\\tools\\common_tools\\scripts\\installers\\game\\lib\\install_game_tool_chain_impl.bat " + GetGameImageServer(project) + " " + project + " Retail " + location;
	//command = "%BIZARRE_ROOT%\\tools\\common_tools\\scripts\\installers\\game\\lib\\install_game_tool_chain_impl.bat " + GetGameImageServer(project) + " " + project + " Retail Live";
	WScript.Echo("Execute command: " + command );
	ExecAndCapture(command);
	
	//Checkout xml from the 'Brain
	command = "z:\\tools\\common_tools\\win32\\nexus\\nexus_cmd.exe -s \"ABGetLatest('Z:/" + project + "/Executer', 'robots', '')\"";
	WScript.Echo("Execute command: " + command );
	ExecAndCapture(command);
	
	//Launch Executer and don't wait....
	command = "Z:\\tools\\common_tools\\win32\\executer\\executer.exe -silent -process_file \"Z:\\" + project + "\\Executer\\Automation\\Recursively Export " + assetType + ".xml\" -a";
  	var WshShell = new ActiveXObject("WScript.Shell");
	WScript.Echo("Execute command: " + command );
	WshShell.Exec("cmd /c " + command);

	if (g_iErrors == 0)
	{
		WScript.Echo("PUBLISH SUCCESSFUL");
	}
	else
	{
		WScript.Echo("PUBLISH FAILED");
	}
	
  </script>
</job>
