<job>
  <script language="JScript" src="..\..\..\..\..\bin\scripts\common\copy.js"/>
  <script language="JScript" src="..\..\..\..\..\bin\scripts\common\exec.js"/>
  <script language="JScript" src="..\..\..\..\..\bin\scripts\luntbuild\PublishUtils.js"/>
  <script language="JScript">
  	
 	var g_iErrors = 0;
 	if (WScript.Arguments.length < 3)
	{
		WScript.Echo("Incorrect number of arguments. Usage: PublishMercuryGameShaders.wsf LOCATION PROJECT PLATFORM ...\n");
	}
	
	
	var location = WScript.Arguments.Item(0);
	var project = WScript.Arguments.Item(1);
	var platforms = WScript.Arguments.Item(2);

	if (platforms == "ALL_PLATFORMS")
	{
		platforms = "XBOX_360 WIN32 PS3";
	}
	
	var dest = GetGameImageServer(project) + "\\" + project + "\\Game\\Retail\\" + location;
	var workingFolder = "z:\\" + project + "\\working";

	//Publish shaders to game image per platform
	PublishShadersToImage(workingFolder, dest, platforms);
	
	if (g_iErrors != 0)
	{
		WScript.Echo("Problems encountered in PublishShadersToImage()");
	}

	if (platforms == "WIN32" || platforms == "XBOX_360 WIN32 PS3")
	{
		//Publish PC version shaders to tools structure
		if (location.toLowerCase() == "live")
		{
			//If going to Live, check into subversion and they will 
			//be auto-propagated to Live folders on server
			PublishShadersToSvnToolsLocation(project);
		}
		
		var source = "Z:\\" + project + "\\tools\\data\\shaders";
		var toolsDest = dest + "\\Tools\\data\\shaders";
			
		RoboCopyFiles(source, toolsDest, true);
		
	}
	if (g_iErrors == 0)
	{
		WScript.Echo("PUBLISH SUCCESSFUL");
	}
	else
	{
		WScript.Echo("PUBLISH FAILED");
	}
		
  </script>
</job>
