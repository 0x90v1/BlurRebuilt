<job>
  <script language="JScript" src="..\..\..\..\..\bin\scripts\common\copy.js"/>
  <script language="JScript" src="..\..\..\..\..\bin\scripts\common\exec.js"/>
  <script language="JScript" src="..\..\..\..\..\bin\scripts\luntbuild\PublishUtils.js"/>
  <script language="JScript">
  
  	var Shell = new ActiveXObject("WScript.shell");
	var Env = Shell.Environment("PROCESS");
  	
  	var g_iErrors = 0;
  	if (WScript.Arguments.length < 3)
	{
		WScript.Echo("Incorrect number of arguments. Usage: PublishMercuryGameTools.wsf LOCATION TOOLNAME PROJECT  ...\n");
	}
	
	var location = WScript.Arguments.Item(0);
	var toolName = WScript.Arguments.Item(1);
	var project = WScript.Arguments.Item(2);

	if (location.toLowerCase() == "live")
	{
		//If going to Live, check into subversion and they will 
		//be auto-propagated to Live folders on server
		PublishToolsToSvnToolsLocation(project, toolName);
	}
	else
	{
		var source = "..\\..\\..\\bin\\tools_WIP\\win32\\" + toolName ;
		var dest = GetGameImageServer(project) + "\\" + project + "\\Game\\Retail\\" + location + "\\Tools\\win32\\" + toolName;
		
		RoboCopyFiles(source, dest, false, null, "*.pdb *.ilk");
	}
	
	// Copy all the code files to SymSrv
	if (Env("SYMBOL_SERVER_NAME") != "")
	{
        if (Env("project_name") != "" && Env("buildVersion") != "")
        {
            var symbolServerSourceFolder = "\\\\" + Env("SYMBOL_SERVER_NAME") + "\\SymbolServer\\Source\\"  + Env("project_name") + "\\" + Env("buildVersion") + "\\code";
            
            // Copy all source code files to server
            var copyInfo = new Object();
            
            copyInfo.source = Env("SRC_ROOT") + "\\code";
            copyInfo.dest   = symbolServerSourceFolder;
            copyInfo.params = "/S"
            
            copyInfo.fileList = "*.cpp *.c *.h *.hpp *.inl";
            
            RoboCopyFilesEx(copyInfo);
            
            copyInfo.fileList = toolName + ".exe " + toolName + ".pdb";
            
            RoboCopyFilesEx(copyInfo);
        
            // Register our exe's
            var symSrvExe = Env("SRC_ROOT") + "\\bin\\build_tools\\symstore.exe";
            var symSrvStore = "\\\\" + Env("SYMBOL_SERVER_NAME") + "\\SymbolServer\\Symbols\\";
            
            var exitcode = ExecAndCapture(symSrvExe + " add /r /p /f " + symbolServerSourceFolder + " /s " + symSrvStore + " /t " + Env("project_name") + " /v \"" + Env("buildVersion") + "\" /c \"Adding " + toolName + "\"");
        }
        else
        {
            if (Env("project_name") == "")
                WScript.Echo("PublishTools: project_name not specified - not copying to symsrv");
            
            if (Env("buildVersion") == "")
                WScript.Echo("PublishTools: buildVersion not specified - not copying to symsrv");
        }
    }
  	
	if (g_iErrors == 0)
	{
		WScript.Echo("PUBLISH SUCCESSFUL");
	}
	else
	{
		WScript.Echo("PUBLISH FAILED");
	}
	
  </script>
</job>
