<job>
  <script language="JScript" src="..\..\..\..\bin\scripts\common\copy.js"/>
  <script language="JScript" src="..\..\..\..\bin\scripts\common\exec.js"/>
  <script language="JScript" src="..\..\..\..\bin\scripts\luntbuild\PublishUtils.js"/>
  <script language="JScript">
  
  	var g_iErrors = 0;
  	
  	var Shell = new ActiveXObject("WScript.shell");
	var Env = Shell.Environment("PROCESS");
	
    if ((WScript.Arguments.length == 2) && (WScript.Arguments.Item(0) == "NONE"))
    {
        var toolName = WScript.Arguments.Item(1);
        
        RegisterWithSymbolServer(toolName);
        
        if (g_iErrors == 0)
            WScript.Echo("PUBLISH SUCCESSFUL");
        
        WScript.Quit(0);
    }

  	if (WScript.Arguments.length < 2)
	{
		WScript.Echo("Incorrect number of arguments. Usage: PublishTest.wsf TOOLNAME PROJECT  ...\n");
	}
	
	var toolName = WScript.Arguments.Item(0);
	var project = WScript.Arguments.Item(1);

	//If going to Live, check into subversion and they will 
	//be auto-propagated to Live folders on server
	PublishToolsToSvnToolsLocation(project, toolName, "_test");

	RegisterWithSymbolServer(toolName);
  	
	if (g_iErrors == 0)
	{
		WScript.Echo("PUBLISH SUCCESSFUL");
	}
	else
	{
		WScript.Echo("PUBLISH FAILED");
	}
	
  </script>
</job>
