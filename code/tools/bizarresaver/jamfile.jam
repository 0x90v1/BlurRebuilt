SubDir TOP Code Tools bizarresaver ;

SupportedTargets WIN32_TOOL ;

PLATFORMSDK = "C:\\Program Files\\Microsoft SDKs\\Windows\\v6.0" ;



rule Installer
{
	Depends $(<) : $(>) ;
	Depends all : $(<) ;
}

actions quietly Installer
{
	Echo Building installer ;
	"$(VCCMNTOOLS)..\IDE\devenv.exe" /Rebuild "$(BUILD)" installer.sln ;
}



IncludePath
./include
;

DXCOMMON_SRC = 
	./source/dxcommon/d3dfont.cpp
	./source/dxcommon/d3dsaver.cpp
	./source/dxcommon/d3dutil.cpp
	./source/dxcommon/dxutil.cpp
;

FARM_SRC = 
	#./source/farm/farm.cpp
	./source/farm/farmassistant.cpp
	#./source/farm/farmcommand.cpp
	#./source/farm/farmcomment.cpp
	#./source/farm/farmjob.cpp
	#./source/farm/farmkill.cpp
	#./source/farm/farmlist.cpp
	#./source/farm/farmmanager.cpp
	#./source/farm/farmpriority.cpp
	./source/farm/farmprocess.cpp
	#./source/farm/farmrequeue.cpp
	./source/farm/farmsaver.cpp
	./source/farm/farmserver.cpp
	./source/farm/farmstranger.cpp
	#./source/farm/farmui.cpp
	#./source/farm/farmuser.cpp
	./source/farm/farmworker.cpp
	./source/farm/network.cpp
	#./source/farm/wndcore.cpp
	#./source/farm/stdafx.cpp
;

SCREENSAVER_SRC = 
	./source/screensaver/bizarresaver.cpp
	./source/screensaver/cpuusage.cpp
	./source/screensaver/firewall.cpp
	#./source/screensaver/models.cpp
	./source/screensaver/saverlogic.cpp
	./source/screensaver/unzip.cpp
;

SCREENSAVER_RESOURCE = 
	./resource/bizarresaver.rc
;

ObjectDefines $(DXCOMMON_SRC) : _CRT_SECURE_NO_WARNINGS ;
ObjectDefines $(FARM_SRC) : _CRT_SECURE_NO_WARNINGS ;
ObjectDefines $(SCREENSAVER_SRC) : _CRT_SECURE_NO_WARNINGS ;

SUBDIRHDRS += \"$(DXSDK_PATH)/include\" \"$(PLATFORMSDK)\\include\" ;
LINKLIBS += comctl32.lib comsuppw.lib Netapi32.lib 	Secur32.lib Winmm.lib dbghelp.lib dxerr.lib d3d9.lib d3dx9.lib ;
LINKFLAGS +=
	/SUBSYSTEM:WINDOWS /MACHINE:X86 
	/LIBPATH:\"$(DXSDK_PATH)/lib/x86\" 
;

LinkLibraries screensaver : dxcommon farm ;

Library dxcommon : $(DXCOMMON_SRC) : dxcommonpch.cpp ;
Library farm : $(FARM_SRC) : farmpch.cpp ;
Application screensaver : $(SCREENSAVER_SRC) <resource>$(SCREENSAVER_RESOURCE) ;


if $(BUILD) = Release
{
	Depends screensaver.exe : ./bin/installer ;
	MkDir ./bin/installer ;

	##WTF: registry entries must use the dos-style 8.3 filenames for the scr otherwise it wont work!!!
	EmbedManifest ./bin/installer/screensaver.scr : screensaver.exe ;	
	Installer "./bin/installer/Release/bizarresaver.msi" : ./bin/installer/screensaver.scr ;
}

ExportVcproj screensaver ;