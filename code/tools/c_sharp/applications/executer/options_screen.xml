<?xml version="1.0" encoding="utf-8" ?>

<root>
	<options_template>

		<enums>
			<enum name="Colour">
				"black"
				"blue"
				"magenta"
				"red"
				"green"
				"cyan"
				"yellow"
				"white"
			</enum>
			<enum name="LightType">
				"Infinite"
				"Ambient"
				"Point"
				"Spot"
				"Hemisphere"
			</enum>
			<enum name = "gender">
				"Male"
				"Female"
			</enum>

			<enum name="CompareModes">
				"Intersection"
				"Union"
				"Like for Like"
			</enum>
		</enums>

		<reference>
			<container name = "new_tree_item" type = "tree_node">
				<container name="Dave" type ="bool" default="true" />
				<container name="Brian" type ="bad type" default="true" pre_format ="cr;" />
				<container name="Peter" type ="bool" default="true" pre_format ="cr;" />
				<container name = "Wilson" type = "basic" pre_format ="cr;"/>
			</container>

			<container name = "Inherited_stuff" type = "basic" >
				<container name="First bool" type ="bool" default="true" />
				<container name="Second bool" type ="bad type" default="true" pre_format ="cr;" />
				<container name="Third bool" type ="bool" default="true" pre_format ="cr;" />
				<container name = "Test_inherit" type = "basic" pre_format ="cr;">
					<container name = "Testval" type = "int" min = "5" max = "9" default = "4" pre_format ="cr;"/>
					<inherit name = "fingers crossed" path = "Inherited stuff.Test inherit.Testval"/>
				</container>
			</container>
		</reference>

		<container name = 'root' display_name = 'Options' type = 'basic'>
			<container name="select_option" type="tree" default = "\"  width ="940" height ="400" split_width ="200" fix_splitter="false">
				<container name="general" type="tree_node" display_name = "General">
					<container name ="general_options" type="basic" display_name="General options">
						<container name="minimise_to_tray"		display_name="Minimise to tray"	type="bool"		default="true"  pre_format="cr;" width = "250"/>
						<container name="store_tree_layout"		display_name="Store tree layout when navigating"	type="bool"	default="false"  pre_format="cr;" width = "250"/>
						<container name="restore_tree_layout"	display_name="Restore tree layout on loading a project"	type="bool"	default="false"  pre_format="cr;" width = "250"/>
						<container name="allow_saving_unmodified_projects"	display_name="Allow saving of unmodified projects"	type="bool"	default="false"  pre_format="cr;" width = "250"/>
						<container name="allow_saving_unmodified_solutions"	display_name="Allow saving of unmodified solutions"	type="bool"	default="false"  pre_format="cr;" width = "250"/>
						<container name="ignore_forced_tree_node_expansions"	display_name="Ignore forced tree node expansions"	type="bool"	default="false"  pre_format="cr;" width = "250"/>
						<container name="multiselect_mode" display_name="Multiselect Compare Mode" type="enum" values="CompareModes" pre_format="cr;"/>
					</container>
				</container>
				<container name="debug" type="tree_node" display_name = "Debug" >
					<container name = "debug_task" type = "tree_node" display_name = "Debug Task options" >
						<container name = "copy_to_clipboard" type = "basic" display_name = "Copy to Clipboard ...">
							<container name="radio_copy_command_line"				display_name="Command line"				type="radio_button" default="false"  pre_format="cr;" />
							<container name="radio_copy_arguments"					display_name="Arguments"					type="radio_button" default="false"  pre_format="cr;" />
							<container name="radio_copy_arguments_filename" display_name="Arguments filename"	type="radio_button" default="false"  pre_format="cr;" />
							<container name="radio_copy_job_xml_description" display_name="Job xml description"	type="radio_button" default="false"  pre_format="cr;" />
							<container name="radio_copy_none"								display_name="None"								type="radio_button" default="true"	 pre_format="cr;" />
						</container>
						<container name = "macros" type = "basic"			display_name = "Macros" pre_format="">
							<container name="macro_command_line"				display_name="Command line (%command_line%)"	type="label" default=""  pre_format="cr;" />
							<container name="macro_arguments"						display_name="Arguments (%args%)"							type="label" default="" pre_format="cr;" />
							<container name="macro_arguments_filename"	display_name="Arguments filename (%args_filename%)"							type="label" default="" pre_format="cr;"/>
						</container>
						<container name = "write_to" type = "basic"			display_name = "Write ..." pre_format="cr;">
							<container name="check_write_command_line"		display_name="Command line"	type="bool"			default="false"  pre_format="cr;" width = "120"/>
							<container name="write_command_line"					display_name="Command line"	type="filename" default="" depends_on = "../check_write_command_line" style = "sparse" />
							<container name="check_write_arguments"				display_name="Arguments"		type="bool"			default="false"  pre_format="cr;" width = "120"/>
							<container name="write_arguments"							display_name="Arguments"		type="filename" default="%args_filename%" depends_on = "../check_write_arguments" style = "sparse"/>
							<container name="check_write_arguments_filename"	display_name="Arguments filename"		type="bool"			default="false"  pre_format="cr;" width = "120"/>
							<container name="write_arguments_filename"		display_name="Arguments filename"				type="filename" default="" depends_on = "../check_write_arguments_filename" style = "sparse"/>
							<container name="check_write_job_xml_description"		display_name="Job xml description"		type="bool"			default="false"  pre_format="cr;" width = "120"/>
							<container name="write_job_xml_description"					display_name="Job xml description"		type="filename" default="" depends_on = "../check_write_job_xml_description" style = "sparse"/>
						</container>
						<container name = "miscellaneous" type = "basic" display_name = "Miscellaneous"	 pre_format="cr;">
							<container name="check_execute"	display_name="Execute"	type="bool"			default="false"  pre_format="cr;" width = "120"/>
							<container name="execute"				display_name="None"		type="string" default="%command_line%" style = "sparse" depends_on ="../check_execute" width = "160"/>
							<container name="execute_args"	display_name="None"		type="string" default="%args%" style = "sparse" depends_on ="../check_execute" width = "160" />
							<container name="check_show_debug"	display_name="Show debug window"	type="bool"			default="true"  pre_format="cr;" width = "120" />
						</container>
					</container>
				</container>
			</container>
		</container>
	</options_template>

</root>


