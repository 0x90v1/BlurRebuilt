								<container name = "sun_elevation" display_name="Sun Elevation" type ="float" default="45.0" pre_format = "cr;"/>
								<container name = "sun_samples" display_name="Sun Samples" type ="int" default="32" pre_format = "cr;"/>
							</container>

							<container name = "sky_light" display_name = "Sky" type = "basic">
