<!ELEMENT root (config, servers, actions, processes?, tree_icon_folder?, types)>
<!ATTLIST root version				CDATA #REQUIRED >

<!ELEMENT tree_icon_folder EMPTY>
<!ATTLIST tree_icon_folder name CDATA #REQUIRED >

<!ELEMENT config EMPTY>
<!ATTLIST config farm_temp_folder				CDATA #REQUIRED >
<!ATTLIST config owner_product_name			CDATA #REQUIRED >

<!ELEMENT servers	(server_definition*)>

<!ELEMENT server_definition EMPTY>
<!ATTLIST server_definition name						CDATA #REQUIRED >
<!ATTLIST server_definition tcp_port				CDATA #REQUIRED >
<!ATTLIST server_definition udp_port				CDATA #IMPLIED >
<!ATTLIST server_definition local_name			CDATA #REQUIRED >
<!ATTLIST server_definition location				CDATA #REQUIRED >
<!ATTLIST server_definition startup_command	CDATA #IMPLIED >
<!ATTLIST server_definition kill_on_exit		(true|false|yes|no) "false" >

<!ELEMENT actions	(action+)>

<!ELEMENT action	(server_list?)>
<!ATTLIST action name CDATA #REQUIRED >
<!ATTLIST action command_line CDATA #REQUIRED >
<!ATTLIST action working_directory CDATA #IMPLIED >
<!ATTLIST action arguments CDATA #IMPLIED >
<!ATTLIST action include_child_data (true|false|yes|no) "false" >
<!ATTLIST action include_parent_data (true|false|yes|no) "false" >
<!ATTLIST action hide_process (true|false|yes|no) "false" >
<!ATTLIST action include_xml_data_file CDATA #IMPLIED >

<!ELEMENT server_list	(server*)>

<!ELEMENT server EMPTY>
<!ATTLIST server local_name CDATA #REQUIRED >

<!ELEMENT processes	(process*)>

<!ELEMENT process	EMPTY>
<!ATTLIST process name CDATA #REQUIRED >
<!ATTLIST process local_name CDATA #REQUIRED >

<!ELEMENT types	(type*)>

<!ELEMENT type	(task_list?, inheritable_types?, sub_menu_template?)>
<!ATTLIST type name CDATA #REQUIRED icon1 CDATA #IMPLIED icon2 CDATA #IMPLIED >

<!ELEMENT task_list (task*)>

<!ELEMENT task EMPTY>
<!ATTLIST task name CDATA #REQUIRED display_name CDATA #REQUIRED action_name CDATA #REQUIRED process_recursively (true|false|yes|no|ask) "ask">
<!ATTLIST task farm_comment CDATA #IMPLIED >

<!ELEMENT inheritable_types (inheritable_type*)>

<!ELEMENT inheritable_type EMPTY>
<!ATTLIST inheritable_type name CDATA #REQUIRED>

<!ELEMENT sub_menu_template (menu_system?)>

<!ELEMENT menu_system (enums?, container)>

<!ELEMENT enums (enum*)>

<!ELEMENT enum (#PCDATA)>
<!ATTLIST enum name CDATA #REQUIRED>

<!ELEMENT container (container*)>
<!ATTLIST container name CDATA #REQUIRED display_name CDATA #IMPLIED type CDATA #REQUIRED >
<!ATTLIST container pre_format CDATA #IMPLIED >
<!ATTLIST container post_format CDATA #IMPLIED >
<!ATTLIST container default CDATA #IMPLIED >
<!ATTLIST container save (true|false) "true">
<!ATTLIST container bitmap CDATA #IMPLIED >
<!ATTLIST container values CDATA #IMPLIED >
<!ATTLIST container filepicker_filter CDATA #IMPLIED >
<!-- Filemask filter for filepicker type. -->
<!ATTLIST container filepicker_share_name CDATA #IMPLIED >
<!ATTLIST container force_local_network_path (true|false) #IMPLIED>
<!ATTLIST container force_file_exists (true|false) #IMPLIED>
<!ATTLIST container force_path_exists (true|false) #IMPLIED>
<!ATTLIST container command CDATA #IMPLIED >
<!ATTLIST container working_directory CDATA #IMPLIED >
<!ATTLIST container always_enabled CDATA #IMPLIED >
<!ATTLIST container min CDATA #IMPLIED >
<!ATTLIST container max CDATA #IMPLIED >
<!ATTLIST container width CDATA #IMPLIED >
<!ATTLIST container depends_on CDATA #IMPLIED >
<!ATTLIST container style CDATA #IMPLIED >

<!--	<!ATTLIST container filepicker_flags CDATA #IMPLIED > -->
