<job>
  <script language="JScript" src="..\..\..\bin\scripts\compilation\setup_paths.JS"/>
  <script language="JScript" src="..\..\..\bin\scripts\compilation\symbol_server.JS"/>
  <script language="JScript">

SetVC8Path();

SetToolsSymbolsServer();

var symbolServerPath = GenerateSymbolServerPath(Env("SYM_SERVER_LOC"), "xFarm");

MakeSourceMap("code\\tools\\xFarm\\xFarm\\", symbolServerPath)

// Build(Src + "code\\tools\\xFarm\\xFarm_2005.sln", "Release YDL");

g_bUseEnv = false;

if (g_iErrors == 0)
{
    Build(Src + "code\\tools\\xFarm\\xFarm_2005.sln", "Release");
}

RevertSourceMap("code\\tools\\xFarm\\xFarm\\");

if ((g_iErrors == 0) && (Env("buildPlatform") != "xUnknown"))
{
    CopyFilesToSymbolServer(
	    ["code" ],			                                                                                        // List of folders to copy to symbol server
	    symbolServerPath,																							// Where to copy them
	    "*.cpp *.c *.h *.hpp");																						// Only copy files matching these extensions
		
    CopyFilesToSymbolServer(
	    ["bin\\export_pipeline\\win32\\xFarm"],
	    symbolServerPath,																			
	    "*.exe *.pdb");																					
		
    RegisterSymbolServer("\"" + symbolServerPath + "bin\\export_pipeline\\win32\\xFarm\\*.*\"", "xFarm-x86", Env("SYM_SERVER_SERVER_LOC"));
}

Finish();

  </script>
</job>
