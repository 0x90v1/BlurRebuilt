/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDI_FARMWINDOW          ICON                    "icon1.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAINMENU MENU 
BEGIN
    POPUP "&View"
    BEGIN
        MENUITEM "&Jobs\tCtrl+J",               ID_VIEW_JOBS
        MENUITEM "&Machines\tCtrl+M",           ID_VIEW_MACHINES
    END
    POPUP "&Tool"
    BEGIN
        MENUITEM "&New Job...\tIns",            ID_TOOL_NEWJOB
        MENUITEM "&Edit Job...\tEnter",         108
        MENUITEM SEPARATOR
        MENUITEM "&Prioritise Job\tCtrl+P",     ID_TOOL_PRIORITISEJOB
        MENUITEM "&Requeue Job\tCtrl+R",        ID_TOOL_REQUEUEJOB
        MENUITEM SEPARATOR
        MENUITEM "&Kill Job\tDel",              ID_TOOL_KILLJOB
        MENUITEM SEPARATOR
        MENUITEM "&Enable Machine\tCtrl+E",     ID_TOOL_ENABLEMACHINE
        MENUITEM "&Disable Machine\tCtrl+D",    ID_TOOL_DISABLEMACHINE
    END
END


/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_NEWJOB DIALOGEX 0, 0, 313, 60
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | 
    WS_CAPTION | WS_SYSMENU
CAPTION "New Job..."
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "&Command",IDC_STATIC,7,8,32,8
    EDITTEXT        IDC_COMMAND,45,7,255,13,ES_AUTOHSCROLL
    LTEXT           "C&omment",IDC_STATIC,7,24,31,8
    EDITTEXT        IDC_COMMENT,45,23,255,12,ES_AUTOHSCROLL
    DEFPUSHBUTTON   "OK",IDOK,195,39,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,250,39,50,14
    LTEXT           "Flags",IDC_STATIC,7,40,18,8
    CONTROL         "Windows",IDC_WINDOWS,"Button",BS_AUTOCHECKBOX | 
                    WS_TABSTOP,45,40,45,10
    CONTROL         "Linux",IDC_LINUX,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,
                    99,40,33,10
    CONTROL         "PVS",IDC_PVS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,143,
                    40,28,10
END


